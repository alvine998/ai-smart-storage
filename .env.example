APP_PORT=8080
APP_ENV=development

MYSQL_DSN=user:password@tcp(localhost:3306)/ai_storage?parseTime=true
REDIS_URL=redis://localhost:6379/0

# JWT auth (APP_JWT_SECRET must be a long random string; if empty a per-boot secret is generated)
APP_JWT_SECRET=
JWT_TTL_HOURS=24

# Comma-separated list of allowed CORS origins; * only for development
CORS_ALLOWED_ORIGINS=*

# Cloudflare R2 (S3-compatible storage)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=ai-smart-storage
R2_PUBLIC_URL=

# MiMo V2.5 — OpenAI-compatible. Two billing modes (keys/URLs are NOT interchangeable):
#   Pay-as-you-go:  BASE_URL=https://api.xiaomimimo.com/v1          API_KEY=sk-xxxxx  (billed per token; set COST_PER_1K to your price)
#   Token Plan:     BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1  API_KEY=tp-xxxxx/rtp-xxxxx  (or cn/ams cluster per your subscription page)
#                 Token Plan is credit-based (mimo-v2.5: 2/100/200, mimo-v2.5-pro: 2.5/300/600 credits per token); leave COST_PER_1K=0 (forced to 0 at runtime).
# Choose ONE pair — mismatched key/host returns 401 Invalid API Key.
MIMO_API_KEY=replace-me
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
MIMO_TIMEOUT_SECONDS=120
MIMO_INPUT_COST_PER_1K=0
MIMO_OUTPUT_COST_PER_1K=0

WHATSAPP_VERIFY_TOKEN=replace-me
WHATSAPP_APP_SECRET=replace-me
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_GRAPH_VERSION=v22.0
